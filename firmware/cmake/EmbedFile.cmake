# Writes one file's bytes as a C++ array definition, at build time, so a program carries the
# committed file byte for byte (the bench configurations' factory packages, bench/FactoryPackages.h).
#   cmake -DIN=firmware/factory/murmuration.bsp -DOUT=FactoryMurmuration.cpp -DSYMBOL=kFactoryMurmuration
#         -DHEADER=bench/FactoryPackages.h -DNAMESPACE=brainscape::fw::bench -P EmbedFile.cmake
foreach(v IN ITEMS IN OUT SYMBOL HEADER NAMESPACE)
  if(NOT DEFINED ${v})
    message(FATAL_ERROR "EmbedFile.cmake: ${v} is not set")
  endif()
endforeach()
if(NOT EXISTS "${IN}")
  message(FATAL_ERROR "EmbedFile.cmake: ${IN} is missing")
endif()
file(SIZE "${IN}" size)
file(READ "${IN}" hex HEX)
string(REPEAT "0x[0-9a-f][0-9a-f]," 16 byte16)
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
string(REGEX REPLACE "(${byte16})" "    \\1\n" hex "${hex}")  # 16 bytes a line
get_filename_component(name "${IN}" NAME)
set(text "// Generated by firmware/cmake/EmbedFile.cmake from ${name}. Do not edit.
#include <cstdint>

#include \"${HEADER}\"

namespace ${NAMESPACE} {

// ${name}, ${size} bytes
alignas(8) const uint8_t ${SYMBOL}[] = {
${hex}
};
const uint32_t ${SYMBOL}Size = ${size}u;

}  // namespace ${NAMESPACE}
")
if(EXISTS "${OUT}")
  file(READ "${OUT}" old)
  if(old STREQUAL text)
    return()
  endif()
endif()
file(WRITE "${OUT}" "${text}")
