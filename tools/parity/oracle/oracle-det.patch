diff --git a/dsp/include/brainscape/BMath.h b/dsp/include/brainscape/BMath.h
new file mode 100644
index 0000000..945664e
--- /dev/null
+++ b/dsp/include/brainscape/BMath.h
@@ -0,0 +1,115 @@
+#pragma once
+#include <cstdint>
+#include <cstring>
+
+// Probe-only stand-in for design contract #7 ("in-tree math, no libm on any path
+// that reaches audio"). Every function is a fixed sequence of IEEE-754 binary64
+// +,-,*,/ plus exact bit manipulation -- no libm, no table whose contents depend
+// on a platform. Compiled with FP contraction OFF, the result is the same bit
+// pattern on any IEEE-754 machine (x86-64 SSE2, Cortex-M7 FPv5-D16 hardware DP).
+// Accuracy is ~1e-15 relative: fine for coefficients; it is NOT tuned for speed.
+namespace brainscape::bm {
+
+inline double Pow2i(int k) noexcept {  // exact 2^k for k in [-1022, 1023]
+  const uint64_t bits = static_cast<uint64_t>(k + 1023) << 52;
+  double d;
+  std::memcpy(&d, &bits, sizeof d);
+  return d;
+}
+inline int RoundToInt(double x) noexcept {  // half away from zero, exact
+  return static_cast<int>(x < 0.0 ? x - 0.5 : x + 0.5);
+}
+
+inline double exp(double x) noexcept {
+  if (x > 709.0) x = 709.0;
+  if (x < -708.0) return 0.0;
+  const int    k     = RoundToInt(x * 1.4426950408889634);
+  const double ln2hi = 6.93147180369123816490e-01;  // fdlibm split: k*ln2hi exact
+  const double ln2lo = 1.90821492927058770002e-10;
+  const double r     = (x - k * ln2hi) - k * ln2lo;  // |r| <= ~0.347
+  double term = 1.0, sum = 1.0;
+  for (int n = 1; n <= 17; ++n) {
+    term = term * r / static_cast<double>(n);
+    sum  = sum + term;
+  }
+  return sum * Pow2i(k);
+}
+
+inline double expm1(double x) noexcept {
+  if (x > 0.5 || x < -0.5) return exp(x) - 1.0;
+  double term = x, sum = x;  // direct series: no cancellation near 0
+  for (int n = 2; n <= 22; ++n) {
+    term = term * x / static_cast<double>(n);
+    sum  = sum + term;
+  }
+  return sum;
+}
+
+inline double exp2(double x) noexcept {
+  const int    k = RoundToInt(x);
+  const double f = x - static_cast<double>(k);  // exact
+  return exp(f * 0.6931471805599453) * Pow2i(k);
+}
+
+inline double log(double x) noexcept {  // x > 0, normal
+  uint64_t bits;
+  std::memcpy(&bits, &x, sizeof bits);
+  int e = static_cast<int>((bits >> 52) & 0x7FF) - 1023;
+  bits  = (bits & 0x000FFFFFFFFFFFFFull) | (static_cast<uint64_t>(1023) << 52);
+  double m;
+  std::memcpy(&m, &bits, sizeof m);  // m in [1, 2)
+  if (m > 1.4142135623730951) { m = m * 0.5; ++e; }
+  const double s = (m - 1.0) / (m + 1.0), s2 = s * s;
+  double term = s, sum = s;
+  for (int n = 3; n <= 31; n += 2) {
+    term = term * s2;
+    sum  = sum + term / static_cast<double>(n);
+  }
+  const double ln2hi = 6.93147180369123816490e-01, ln2lo = 1.90821492927058770002e-10;
+  return static_cast<double>(e) * ln2hi + (2.0 * sum + static_cast<double>(e) * ln2lo);
+}
+
+inline void SinCosReduced(double r, double* s, double* c) noexcept {  // |r| <= pi/4
+  const double r2 = r * r;
+  double ts = r, ss = r, tc = 1.0, sc = 1.0;
+  for (int n = 1; n <= 11; ++n) {
+    ts = -ts * r2 / static_cast<double>((2 * n) * (2 * n + 1));
+    ss = ss + ts;
+    tc = -tc * r2 / static_cast<double>((2 * n - 1) * (2 * n));
+    sc = sc + tc;
+  }
+  *s = ss;
+  *c = sc;
+}
+inline void SinCos(double x, double* s, double* c) noexcept {  // |x| modest (< 1e4)
+  const int    q = RoundToInt(x * 0.63661977236758134308);
+  const double pio2_1  = 1.57079632673412561417e+00;  // fdlibm 33-bit split
+  const double pio2_1t = 6.07710050650619224932e-11;
+  const double r = (x - q * pio2_1) - q * pio2_1t;
+  double sr, cr;
+  SinCosReduced(r, &sr, &cr);
+  switch (q & 3) {
+    case 0: *s = sr;  *c = cr;  break;
+    case 1: *s = cr;  *c = -sr; break;
+    case 2: *s = -sr; *c = -cr; break;
+    default: *s = -cr; *c = sr; break;
+  }
+}
+inline double sin(double x) noexcept { double s, c; SinCos(x, &s, &c); return s; }
+inline double cos(double x) noexcept { double s, c; SinCos(x, &s, &c); return c; }
+inline double pow(double x, double y) noexcept {
+  if (x <= 0.0) return x == 0.0 ? 0.0 : 0.0;  // engine never passes x<0
+  return exp(y * log(x));
+}
+
+// float overloads: evaluate in binary64, round once.
+inline float exp(float x) noexcept { return static_cast<float>(exp(static_cast<double>(x))); }
+inline float exp2(float x) noexcept { return static_cast<float>(exp2(static_cast<double>(x))); }
+inline float log(float x) noexcept { return static_cast<float>(log(static_cast<double>(x))); }
+inline float sin(float x) noexcept { return static_cast<float>(sin(static_cast<double>(x))); }
+inline float cos(float x) noexcept { return static_cast<float>(cos(static_cast<double>(x))); }
+inline float pow(float x, float y) noexcept {
+  return static_cast<float>(pow(static_cast<double>(x), static_cast<double>(y)));
+}
+
+}  // namespace brainscape::bm
