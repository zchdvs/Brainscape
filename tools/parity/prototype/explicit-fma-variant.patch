diff --git a/dsp/include/brainscape/DetMath.h b/dsp/include/brainscape/DetMath.h
new file mode 100644
index 0000000..1166ac3
--- /dev/null
+++ b/dsp/include/brainscape/DetMath.h
@@ -0,0 +1,311 @@
+#pragma once
+#include <cstdint>
+#include <cstring>
+#if !defined(__GNUC__)
+#include <cmath>  // MSVC: std::sqrt lowers to sqrtss/sqrtsd (IEEE correctly rounded)
+#endif
+
+// Deterministic in-tree math — the "determinism profile" prototype (design §10
+// contracts #6/#7). Every function below is built ONLY from IEEE-754 basic
+// operations (+ - * / and, via Sqrt, sqrt), comparisons, integer/bit operations
+// and exact conversions, with ONE floating operation per statement so that the
+// evaluation order is fixed by the source text. Under the profile's build rule
+// (FP contraction OFF, no -ffast-math / /fp:fast, round-to-nearest, SSE2/VFP
+// scalar — never x87) every IEEE-conforming compiler must produce bit-identical
+// results: MSVC x64, GCC, Clang, arm-none-eabi-gcc (Cortex-M7 FPv5-D16).
+//
+// Polynomial coefficients are hexadecimal floating literals (exact; no
+// decimal-to-binary conversion latitude between compilers). Kernels evaluate in
+// double and round once to float, so the float wrappers are within ~0.5 ulp of
+// the correctly rounded result over the engine's argument ranges (measured by
+// the accuracy probe, not assumed).
+//
+// Splitting every multiply and add into its own statement also makes these
+// kernels immune to Clang's default -ffp-contract=on (which only fuses within one
+// expression); GCC's -ffp-contract=fast still crosses statements, so the build
+// rule remains mandatory for the engine as a whole.
+
+// Optional: keep the (cold: birth/param-change/init) double kernels out of line to save
+// flash on the M7 (-DBS_DETMATH_NOINLINE). Inlining never changes results here: the
+// same IEEE operations run in the same order either way.
+#if defined(BS_DETMATH_NOINLINE) && defined(__GNUC__)
+#define BS_DETMATH_KERNEL __attribute__((noinline))
+#else
+#define BS_DETMATH_KERNEL
+#endif
+
+namespace brainscape::detmath {
+
+// ── Exact helpers ────────────────────────────────────────────────────────────────
+
+inline float Abs(float x) noexcept {  // bit-exact fabsf (clears the sign bit only)
+  uint32_t u;
+  std::memcpy(&u, &x, sizeof u);
+  u &= 0x7FFFFFFFu;
+  std::memcpy(&x, &u, sizeof u);
+  return x;
+}
+
+// lround/llround semantics (round half away from zero), exact: x - trunc(x) is
+// always exactly representable. Valid for |x| < 2^31 (I32) / 2^62 (I64).
+inline int32_t RoundHalfAwayI32(double x) noexcept {
+  const auto   t    = static_cast<int32_t>(x);
+  const double frac = x - static_cast<double>(t);
+  if (frac >= 0.5) return t + 1;
+  if (frac <= -0.5) return t - 1;
+  return t;
+}
+inline int64_t RoundHalfAwayI64(double x) noexcept {
+  const auto   t    = static_cast<int64_t>(x);
+  const double frac = x - static_cast<double>(t);
+  if (frac >= 0.5) return t + 1;
+  if (frac <= -0.5) return t - 1;
+  return t;
+}
+
+// ceil for |x| < 2^31, exact.
+inline double CeilSmall(double x) noexcept {
+  const auto t = static_cast<double>(static_cast<int32_t>(x));
+  return t < x ? t + 1.0 : t;
+}
+
+// x * 2^n for a normal result, exact (pure exponent construction).
+inline double ScaleB(double x, int32_t n) noexcept {
+  const uint64_t bits = static_cast<uint64_t>(static_cast<int64_t>(n) + 1023) << 52;
+  double s;
+  std::memcpy(&s, &bits, sizeof s);
+  return x * s;
+}
+
+// IEEE-754 requires sqrt to be correctly rounded, so it is the one non-basic
+// operation the profile allows. GCC/Clang: build with -fno-math-errno or the
+// builtin keeps an errno fallback call to sqrtf/sqrt for negative inputs.
+#if defined(__GNUC__)
+inline float  SqrtF(float x) noexcept { return __builtin_sqrtf(x); }
+inline double SqrtD(double x) noexcept { return __builtin_sqrt(x); }
+#else
+inline float  SqrtF(float x) noexcept { return std::sqrt(x); }
+inline double SqrtD(double x) noexcept { return std::sqrt(x); }
+#endif
+
+// Explicit fused multiply-add: IEEE-754 fusedMultiplyAdd (single rounding) — exactly
+// specified, so placing it explicitly is portable. GCC/Clang: inline vfma/vfmadd when
+// the ISA has it (Cortex-M7 FPv5, x86-64-v3), else a call to libm fmaf (exact).
+// MSVC: std::fma -> UCRT fmaf (FMA3 at runtime, exact software fallback otherwise).
+#if defined(__GNUC__)
+inline float FmaF(float a, float b, float c) noexcept { return __builtin_fmaf(a, b, c); }
+#else
+inline float FmaF(float a, float b, float c) noexcept { return std::fma(a, b, c); }
+#endif
+
+// ── exp family ───────────────────────────────────────────────────────────────────
+
+// e^r for |r| <= 0.35 (Taylor to r^13; truncation < 5e-18 relative).
+BS_DETMATH_KERNEL inline double ExpKernel(double r) noexcept {
+  double p = 0x1.6124613a86d09p-33;  // 1/13!
+  p = p * r;  p = p + 0x1.1eed8eff8d898p-29;  // 1/12!
+  p = p * r;  p = p + 0x1.ae64567f544e4p-26;  // 1/11!
+  p = p * r;  p = p + 0x1.27e4fb7789f5cp-22;  // 1/10!
+  p = p * r;  p = p + 0x1.71de3a556c734p-19;  // 1/9!
+  p = p * r;  p = p + 0x1.a01a01a01a01ap-16;  // 1/8!
+  p = p * r;  p = p + 0x1.a01a01a01a01ap-13;  // 1/7!
+  p = p * r;  p = p + 0x1.6c16c16c16c17p-10;  // 1/6!
+  p = p * r;  p = p + 0x1.1111111111111p-7;   // 1/5!
+  p = p * r;  p = p + 0x1.5555555555555p-5;   // 1/4!
+  p = p * r;  p = p + 0x1.5555555555555p-3;   // 1/3!
+  p = p * r;  p = p + 0x1.0000000000000p-1;   // 1/2!
+  p = p * r;  p = p + 1.0;
+  p = p * r;  p = p + 1.0;
+  return p;
+}
+
+// 2^x, |x| <= 1000. n = nearest integer; f = x - n is exact (Sterbenz).
+BS_DETMATH_KERNEL inline double Exp2D(double x) noexcept {
+  const int32_t n = RoundHalfAwayI32(x);
+  const double  f = x - static_cast<double>(n);
+  const double  r = f * 0x1.62e42fefa39efp-1;  // ln 2
+  return ScaleB(ExpKernel(r), n);
+}
+
+// e^x, |x| <= 700. Cody-Waite reduction with a 32-bit-trailing-zero ln2_hi so
+// n*ln2_hi is exact for |n| < 2^20.
+BS_DETMATH_KERNEL inline double ExpD(double x) noexcept {
+  const double  t  = x * 0x1.71547652b82fep+0;  // log2(e)
+  const int32_t n  = RoundHalfAwayI32(t);
+  const double  nd = static_cast<double>(n);
+  const double  hi = nd * 0x1.62e42fee00000p-1;  // ln2_hi (exact product)
+  const double  lo = nd * 0x1.a39ef35793c76p-33; // ln2_lo
+  double r = x - hi;
+  r = r - lo;
+  return ScaleB(ExpKernel(r), n);
+}
+
+// e^x - 1 without cancellation for small |x| (direct series below 0.25; the
+// engine's coefficient arguments are -1.44..-2e-4).
+BS_DETMATH_KERNEL inline double Expm1D(double x) noexcept {
+  const double ax = x < 0.0 ? -x : x;
+  if (ax < 0.25) {
+    // x + x^2/2! + ... + x^15/15!: truncation < 1e-19 relative at |x| = 0.25.
+    double p = 0x1.ae7f3e733b81fp-41;  // 1/15!
+    p = p * x;  p = p + 0x1.93974a8c07c9dp-37;  // 1/14!
+    p = p * x;  p = p + 0x1.6124613a86d09p-33;  // 1/13!
+    p = p * x;  p = p + 0x1.1eed8eff8d898p-29;  // 1/12!
+    p = p * x;  p = p + 0x1.ae64567f544e4p-26;  // 1/11!
+    p = p * x;  p = p + 0x1.27e4fb7789f5cp-22;  // 1/10!
+    p = p * x;  p = p + 0x1.71de3a556c734p-19;  // 1/9!
+    p = p * x;  p = p + 0x1.a01a01a01a01ap-16;  // 1/8!
+    p = p * x;  p = p + 0x1.a01a01a01a01ap-13;  // 1/7!
+    p = p * x;  p = p + 0x1.6c16c16c16c17p-10;  // 1/6!
+    p = p * x;  p = p + 0x1.1111111111111p-7;   // 1/5!
+    p = p * x;  p = p + 0x1.5555555555555p-5;   // 1/4!
+    p = p * x;  p = p + 0x1.5555555555555p-3;   // 1/3!
+    p = p * x;  p = p + 0x1.0000000000000p-1;   // 1/2!
+    p = p * x;                                  // x/2 + x^2/6 + ...
+    p = p * x;                                  // x^2/2 + ...
+    return x + p;
+  }
+  const double e = ExpD(x);
+  return e - 1.0;
+}
+
+// ── log family ───────────────────────────────────────────────────────────────────
+
+// ln(x) for finite normal x > 0. x = m * 2^e with m in [sqrt(1/2), sqrt(2));
+// ln(m) = 2 atanh(s), s = (m-1)/(m+1), |s| <= 0.1716 (series to s^25).
+BS_DETMATH_KERNEL inline double LogD(double x) noexcept {
+  uint64_t bits;
+  std::memcpy(&bits, &x, sizeof bits);
+  int32_t e = static_cast<int32_t>((bits >> 52) & 0x7FFu) - 1023;
+  bits = (bits & 0x000FFFFFFFFFFFFFull) | 0x3FF0000000000000ull;  // m in [1, 2)
+  double m;
+  std::memcpy(&m, &bits, sizeof m);
+  if (m > 0x1.6a09e667f3bcdp+0) {  // sqrt(2)
+    m = m * 0.5;                  // exact
+    e = e + 1;
+  }
+  const double num = m - 1.0;  // exact (Sterbenz)
+  const double den = m + 1.0;
+  const double s   = num / den;
+  const double z   = s * s;
+  // 2/(2k+1) for k = 12..1, Horner in z.
+  double p = 0x1.47ae147ae147bp-4;          // 2/25
+  p = p * z;  p = p + 0x1.642c8590b2164p-4;  // 2/23
+  p = p * z;  p = p + 0x1.8618618618618p-4;  // 2/21
+  p = p * z;  p = p + 0x1.af286bca1af28p-4;  // 2/19
+  p = p * z;  p = p + 0x1.e1e1e1e1e1e1ep-4;  // 2/17
+  p = p * z;  p = p + 0x1.1111111111111p-3;  // 2/15
+  p = p * z;  p = p + 0x1.3b13b13b13b14p-3;  // 2/13
+  p = p * z;  p = p + 0x1.745d1745d1746p-3;  // 2/11
+  p = p * z;  p = p + 0x1.c71c71c71c71cp-3;  // 2/9
+  p = p * z;  p = p + 0x1.2492492492492p-2;  // 2/7
+  p = p * z;  p = p + 0x1.999999999999ap-2;  // 2/5
+  p = p * z;  p = p + 0x1.5555555555555p-1;  // 2/3
+  p = p * z;                                 // (2/3)z + ...
+  p = p * s;                                 // tail of 2 atanh(s) beyond 2s
+  const double s2  = s + s;                  // exact
+  const double lnm = s2 + p;
+  const double ed  = static_cast<double>(e);
+  const double hi  = ed * 0x1.62e42fee00000p-1;   // exact
+  const double lo  = ed * 0x1.a39ef35793c76p-33;
+  double r = lo + lnm;
+  r = r + hi;
+  return r;
+}
+
+inline double Log2D(double x) noexcept {
+  const double l = LogD(x);
+  return l * 0x1.71547652b82fep+0;  // 1/ln2
+}
+
+// ── sin / cos ────────────────────────────────────────────────────────────────────
+
+// sin(r), cos(r) for |r| <= pi/4 (+tiny): Taylor to r^17 / r^18, truncation
+// < 1e-19 relative.
+inline double SinKernel(double r) noexcept {
+  const double z = r * r;
+  double p = 0x1.952c77030ad4ap-49;          // 1/17!
+  p = p * z;  p = p - 0x1.ae7f3e733b81fp-41;  // 1/15!
+  p = p * z;  p = p + 0x1.6124613a86d09p-33;  // 1/13!
+  p = p * z;  p = p - 0x1.ae64567f544e4p-26;  // 1/11!
+  p = p * z;  p = p + 0x1.71de3a556c734p-19;  // 1/9!
+  p = p * z;  p = p - 0x1.a01a01a01a01ap-13;  // 1/7!
+  p = p * z;  p = p + 0x1.1111111111111p-7;   // 1/5!
+  p = p * z;  p = p - 0x1.5555555555555p-3;   // 1/3!
+  p = p * z;
+  p = p * r;
+  return r + p;
+}
+inline double CosKernel(double r) noexcept {
+  const double z = r * r;
+  // Horner: 1/18!, -1/16!, 1/14!, -1/12!, 1/10!, -1/8!, 1/6!, -1/4!, 1/2!
+  double p = 0x1.6827863b97d97p-53;           // 1/18!
+  p = p * z;  p = p - 0x1.ae7f3e733b81fp-45;  // 1/16!
+  p = p * z;  p = p + 0x1.93974a8c07c9dp-37;  // 1/14!
+  p = p * z;  p = p - 0x1.1eed8eff8d898p-29;  // 1/12!
+  p = p * z;  p = p + 0x1.27e4fb7789f5cp-22;  // 1/10!
+  p = p * z;  p = p - 0x1.a01a01a01a01ap-16;  // 1/8!
+  p = p * z;  p = p + 0x1.6c16c16c16c17p-10;  // 1/6!
+  p = p * z;  p = p - 0x1.5555555555555p-5;   // 1/4!
+  p = p * z;  p = p + 0x1.0000000000000p-1;   // 1/2!
+  p = p * z;                                  // z/2 - z^2/24 + ...
+  return 1.0 - p;
+}
+
+// sin/cos of x radians, |x| <= 2^19 * pi/2. Cody-Waite 3-part pi/2 (fdlibm split;
+// n*P1 and n*P2 are exact products for |n| < 2^20).
+BS_DETMATH_KERNEL inline void SinCosD(double x, double* s, double* c) noexcept {
+  const double  t  = x * 0x1.45f306dc9c883p-1;  // 2/pi
+  const int32_t n  = RoundHalfAwayI32(t);
+  const double  nd = static_cast<double>(n);
+  const double  p1 = nd * 0x1.921fb54400000p+0;
+  const double  p2 = nd * 0x1.0b4611a600000p-34;
+  const double  p3 = nd * 0x1.3198a2e037073p-69;
+  double r = x - p1;
+  r = r - p2;
+  r = r - p3;
+  const double sk = SinKernel(r);
+  const double ck = CosKernel(r);
+  switch (static_cast<uint32_t>(n) & 3u) {
+    case 0: *s = sk;  *c = ck;  break;
+    case 1: *s = ck;  *c = -sk; break;
+    case 2: *s = -sk; *c = -ck; break;
+    default: *s = -ck; *c = sk; break;
+  }
+}
+inline double SinD(double x) noexcept { double s, c; SinCosD(x, &s, &c); return s; }
+inline double CosD(double x) noexcept { double s, c; SinCosD(x, &s, &c); return c; }
+
+// sin(pi*x), cos(pi*x) in half-turns: the reduction x - n/2 is EXACT, so table
+// builds (window LUT, Hann, FFT twiddles) carry no pi-rounding in the argument.
+BS_DETMATH_KERNEL inline void SinCosPi(double x, double* s, double* c) noexcept {
+  const double  t  = x + x;                  // exact
+  const int32_t n  = RoundHalfAwayI32(t);
+  const double  h  = static_cast<double>(n) * 0.5;  // exact
+  const double  f  = x - h;                  // exact, |f| <= 1/4
+  const double  r  = f * 0x1.921fb54442d18p+1;  // pi
+  const double  sk = SinKernel(r);
+  const double  ck = CosKernel(r);
+  switch (static_cast<uint32_t>(n) & 3u) {
+    case 0: *s = sk;  *c = ck;  break;
+    case 1: *s = ck;  *c = -sk; break;
+    case 2: *s = -sk; *c = -ck; break;
+    default: *s = -ck; *c = sk; break;
+  }
+}
+inline double SinPi(double x) noexcept { double s, c; SinCosPi(x, &s, &c); return s; }
+inline double CosPi(double x) noexcept { double s, c; SinCosPi(x, &s, &c); return c; }
+
+// ── float front-ends (one rounding from a double kernel) ─────────────────────────
+
+inline float Exp2F(float x) noexcept { return static_cast<float>(Exp2D(static_cast<double>(x))); }
+inline float LogF(float x) noexcept { return static_cast<float>(LogD(static_cast<double>(x))); }
+inline float SinF(float x) noexcept { return static_cast<float>(SinD(static_cast<double>(x))); }
+inline float CosF(float x) noexcept { return static_cast<float>(CosD(static_cast<double>(x))); }
+// powf for x > 0 (normal): exp2(y * log2(x)) in double, one final rounding.
+inline float PowF(float x, float y) noexcept {
+  const double l = Log2D(static_cast<double>(x));
+  const double t = static_cast<double>(y) * l;
+  return static_cast<float>(Exp2D(t));
+}
+
+}  // namespace brainscape::detmath
diff --git a/dsp/include/brainscape/FpProfile.h b/dsp/include/brainscape/FpProfile.h
new file mode 100644
index 0000000..831139c
--- /dev/null
+++ b/dsp/include/brainscape/FpProfile.h
@@ -0,0 +1,24 @@
+#pragma once
+// Determinism profile, source-level enforcement (prototype). Included FIRST in every
+// engine translation unit so a mis-set build flag cannot silently re-enable FP
+// contraction or value-unsafe math. The build-system flags stay the primary rule;
+// this is the belt to their braces.
+#include <cfloat>
+
+#if defined(__FAST_MATH__)
+#error "brainscape determinism profile: -ffast-math / -Ofast is forbidden"
+#endif
+#if defined(_MSC_VER) && !defined(__clang__) && defined(_M_FP_FAST)
+#error "brainscape determinism profile: /fp:fast is forbidden"
+#endif
+#if defined(FLT_EVAL_METHOD) && FLT_EVAL_METHOD != 0
+#error "brainscape determinism profile: requires FLT_EVAL_METHOD == 0 (SSE2/VFP scalar, no x87)"
+#endif
+
+#if defined(__clang__)
+#pragma STDC FP_CONTRACT OFF
+#elif defined(__GNUC__)
+#pragma GCC optimize("fp-contract=off")
+#elif defined(_MSC_VER)
+#pragma fp_contract(off)
+#endif
